<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.f_jvfx2.controller.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="Mantenedor de personas">
      <font>
         <Font name="Arial Bold" size="24.0" />
      </font></Label>
   <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
      <children>
          <Button fx:id="btnCrear" onAction="#onCrearButtonClick" prefWidth="200.0" text="Crear">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnListar" mnemonicParsing="false" onAction="#onListarButtonClick" prefWidth="200.0" text="Listar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditarButtonClick" prefWidth="200.0" text="Editar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminarButtonClick" prefWidth="200.0" text="Eliminar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#onBuscarButtonClick" prefWidth="200.0" text="Buscar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#onSalirButtonClick" prefWidth="200.0" text="Salir">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
      </children>
      <opaqueInsets>
         <Insets />
      </opaqueInsets>
   </VBox>
</VBox>
